# Copy to .env (never commit .env). Every variable is optional in development.
GRAPHGUARD_ENVIRONMENT=development        # development | production | test
GRAPHGUARD_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
GRAPHGUARD_LOG_FORMAT=text                # text | json
# GRAPHGUARD_DOCS_ENABLED=true            # /docs page. Default: on in development, off in production
GRAPHGUARD_MAX_REQUEST_BODY_BYTES=1000000
GRAPHGUARD_RATE_LIMIT_PER_MINUTE=60
# JSON lists of browser origins (scheme + host + port, no path, no "*")
GRAPHGUARD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GRAPHGUARD_WS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# GRAPHGUARD_DATABASE_PATH=./data/graphguard.db
# --- Optional AI assistant. Everything works without it. ---
GRAPHGUARD_LLM_PROVIDER=none              # none | anthropic | openai_compatible
# GRAPHGUARD_LLM_MODEL=                   # the model name from your provider's documentation
# GRAPHGUARD_LLM_API_KEY=                 # a secret: never commit it
# GRAPHGUARD_LLM_BASE_URL=                # e.g. http://localhost:11434/v1 for a local Ollama server
GRAPHGUARD_LLM_TIMEOUT_SECONDS=30
# --- ML triage of alerts (a trained classifier on top of the rules) ---
GRAPHGUARD_ML_ENABLED=true                # false = rules only, exactly as before
# GRAPHGUARD_ML_MODEL_PATH=               # default: the model bundled in backend/app/ml/artifacts
# --- Retrieval for the assistant (RAG) ---
GRAPHGUARD_RAG_EMBEDDER=auto              # auto | fastembed | lsa  (lsa = offline, no download)
GRAPHGUARD_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
